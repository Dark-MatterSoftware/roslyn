<Project>
  <!--
    Compiles Visual Basic with the Vb.Next compiler built from this repo instead of the compiler in the .NET SDK.
    Import this file from a project, or from a Directory.Build.props, and set LangVersion to vbnext.

    Build the compiler first:
      dotnet build src\Compilers\VisualBasic\vbc\AnyCpu\vbc.csproj -c Release -f net472

    Set VbNextCompilerDir to use a vbc.exe from another folder. Otherwise a compiler\net472 folder beside this file,
    as in the release ZIP, is used, and then the compiler built in this repo.
  -->
  <PropertyGroup>
    <VbNextCompilerDir Condition="'$(VbNextCompilerDir)' == '' and Exists('$(MSBuildThisFileDirectory)compiler\net472\vbc.exe')">$(MSBuildThisFileDirectory)compiler\net472\</VbNextCompilerDir>
    <VbNextCompilerDir Condition="'$(VbNextCompilerDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\bin\vbc\Release\net472\</VbNextCompilerDir>
    <VbcToolPath>$(VbNextCompilerDir)</VbcToolPath>
    <VbcToolExe>vbc.exe</VbcToolExe>
    <!-- The SDK's compiler server, and Visual Studio's in-process compiler, would compile with their own compiler. -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <UseHostCompilerIfAvailable>false</UseHostCompilerIfAvailable>
  </PropertyGroup>

  <Target Name="VbNextCheckCompiler" BeforeTargets="CoreCompile" Condition="'$(Language)' == 'VB'">
    <Error Condition="!Exists('$(VbNextCompilerDir)vbc.exe')"
           Text="The Vb.Next compiler was not found at '$(VbNextCompilerDir)vbc.exe'. Build src\Compilers\VisualBasic\vbc\AnyCpu\vbc.csproj with -c Release -f net472, or set VbNextCompilerDir." />
  </Target>
</Project>
