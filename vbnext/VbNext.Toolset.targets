<Project>
  <!--
    Selects the Vb.Next compiler that VbNext.Toolset.props found. Import VbNext.Toolset.props first, then import this
    file late, from a Directory.Build.targets, so it is read after the ImportBefore files of Microsoft.VisualBasic.targets,
    such as the RoslynDev compiler extension's, which would otherwise replace VbcToolPath.
    VbNextCheckCompiler in VbNext.Toolset.props checks the result before CoreCompile.
  -->
  <PropertyGroup Condition="'$(VbNextToolsetPropsImported)' == 'true'">
    <VbNextToolsetTargetsImported>true</VbNextToolsetTargetsImported>
    <VbcToolPath>$(VbNextCompilerDir)</VbcToolPath>
    <VbcToolExe>vbc.exe</VbcToolExe>
  </PropertyGroup>

  <!--
    The Vb.Next compiler does not include the Windows PDB writer, Microsoft.DiaSymReader.Native, which DebugType full and
    pdbonly need. Those projects get a portable PDB, the .NET SDK default, instead of failing with BC37225.
  -->
  <PropertyGroup Condition="'$(VbNextToolsetPropsImported)' == 'true' and '$(MSBuildProjectExtension)' == '.vbproj' and ('$(DebugType)' == 'full' or '$(DebugType)' == 'pdbonly')">
    <_VbNextRequestedDebugType>$(DebugType)</_VbNextRequestedDebugType>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <Target Name="VbNextReportDebugType" BeforeTargets="CoreCompile" Condition="'$(_VbNextRequestedDebugType)' != ''">
    <Warning Code="VBNEXT0001" Condition="'$(DebugType)' == 'portable'" Text="DebugType=$(_VbNextRequestedDebugType) is not supported by the Vb.Next compiler, which does not include the Windows PDB writer; emitting a portable PDB instead. Set DebugType to portable or embedded to remove this warning." />
    <!-- A global property, such as -p:DebugType=full on the command line, cannot be changed by the PropertyGroup above. -->
    <Error Code="VBNEXT0002" Condition="'$(DebugType)' != 'portable'" Text="DebugType=$(DebugType) is not supported by the Vb.Next compiler, which does not include the Windows PDB writer. It was set as an MSBuild global property, for example -p:DebugType=$(DebugType) on the command line, which the Vb.Next toolset cannot change, so nothing was compiled. Select portable or embedded debug symbols, for example -p:DebugType=portable." />
  </Target>

  <Target Name="VbNextCheckToolsetProps" BeforeTargets="CoreCompile" Condition="'$(Language)' == 'VB' and '$(VbNextToolsetPropsImported)' != 'true'">
    <Error Text="VbNext.Toolset.targets was imported without VbNext.Toolset.props. Import VbNext.Toolset.props from a Directory.Build.props." />
  </Target>
</Project>
